# === TTS ===
# TTS_PROVIDER: elevenlabs or minimax
TTS_PROVIDER=elevenlabs

# ElevenLabs (international)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_voice_id
ELEVENLABS_MODEL=eleven_v4

# MiniMax (China-friendly, no foreign card needed)
# MINIMAX_API_KEY=your_minimax_api_key
# MINIMAX_GROUP_ID=your_group_id
# MINIMAX_VOICE_ID=male-qn-qingse
# MINIMAX_TTS_MODEL=speech-02-turbo

# === LLM ===
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
SYSTEM_PROMPT=You are a caring AI companion.

# === Speech-to-Text ===
# STT_MODE: cloud (recommended) or local
STT_MODE=cloud
# STT_PROVIDER: groq, deepgram, aliyun, volcengine, baidu
STT_PROVIDER=groq
STT_API_KEY=your_stt_api_key
STT_MODEL=whisper-large-v3
# Aliyun extra: STT_APPKEY=your_appkey
# Volcengine extra: STT_APPID=your_appid
# Custom endpoint: STT_ENDPOINT=https://your-endpoint

# For local mode only:
# WHISPER_MODEL=base

# === General ===
LANGUAGE=zh
PORT=8443
HOST=0.0.0.0

# SSL (required for microphone access on mobile)
SSL_CERT=/certs/fullchain.pem
SSL_KEY=/certs/privkey.pem

# MCP (optional, for Aru post-call sync)
MCP_ENABLED=true
MCP_PATH=/mcp
